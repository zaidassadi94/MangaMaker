# ─────────────────────────────────────────────────────────────────────────────
# MangaForge environment. Copy to `.env.local` and fill in what you need.
# The app runs fully with ZERO keys using the built-in mock image provider.
# NOTHING here should ever be prefixed NEXT_PUBLIC_ — all secrets stay server-side.
# ─────────────────────────────────────────────────────────────────────────────

# Story AI (Claude). Optional — without it, a deterministic mock story is used.
ANTHROPIC_API_KEY=
# Override the Claude model used for story generation (optional).
ANTHROPIC_MODEL=claude-sonnet-4-6

# Image generation provider: mock | gemini | fal
IMAGE_PROVIDER=mock

# Google Gemini (gemini-2.5-flash-image). Required only if IMAGE_PROVIDER=gemini.
GOOGLE_API_KEY=

# fal.ai (Flux Kontext-style endpoints). Required only if IMAGE_PROVIDER=fal.
FAL_KEY=

# Database. Accepts a local SQLite file OR a remote Turso libsql:// url.
DATABASE_URL=file:./data/mangaforge.db
# Turso only:
DATABASE_AUTH_TOKEN=

# Storage adapter for generated art: local | s3
STORAGE_ADAPTER=local
# S3 / R2 / B2 / MinIO (required only if STORAGE_ADAPTER=s3)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Cost containment
MAX_PANELS_PER_DAY=200
MAX_PAGES_PER_CHAPTER=24

# Optional Upstash Redis REST for distributed rate limiting.
# (Falls back to an in-memory sliding window when unset.)
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
